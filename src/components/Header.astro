---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<button type="button" class="theme-toggle" aria-label="Toggle dark mode">
				<svg class="theme-icon sun-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="4"></circle>
					<line x1="12" y1="2" x2="12" y2="5"></line>
					<line x1="12" y1="19" x2="12" y2="22"></line>
					<line x1="2" y1="12" x2="5" y2="12"></line>
					<line x1="19" y1="12" x2="22" y2="12"></line>
					<line x1="4.93" y1="4.93" x2="7.05" y2="7.05"></line>
					<line x1="16.95" y1="16.95" x2="19.07" y2="19.07"></line>
					<line x1="4.93" y1="19.07" x2="7.05" y2="16.95"></line>
					<line x1="16.95" y1="7.05" x2="19.07" y2="4.93"></line>
				</svg>
				<svg class="theme-icon moon-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<path fill="currentColor" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
				</svg>
			</button>
			<a href="https://github.com/leochen4891" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
			<a href="https://www.linkedin.com/in/leochen4891" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">LinkedIn</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24">
					<path
						fill="currentColor"
						d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.28 2.38 4.28 5.47v6.27zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 2em;
		background: var(--bg-elevated);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
	}
	@media (max-width: 720px) {
		header {
			padding: 0 1em;
		}
	}
	.theme-toggle {
		position: relative;
		width: 56px;
		height: 28px;
		border-radius: 14px;
		background: rgba(var(--gray-light), 0.6);
		border: 1px solid rgba(var(--gray), 0.3);
		box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.08);
		cursor: pointer;
		padding: 0;
		margin-right: 0.5em;
		box-sizing: border-box;
		flex-shrink: 0;
	}
	.theme-toggle:hover {
		border-color: rgba(var(--gray), 0.55);
	}
	.theme-toggle:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.theme-toggle::before {
		content: '';
		position: absolute;
		top: 2px;
		left: 2px;
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: #f59e0b;
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
		transition: transform 0.25s ease, background-color 0.25s ease;
		z-index: 0;
	}
	:global(html[data-theme="dark"]) .theme-toggle::before {
		transform: translateX(28px);
		background: #d8dee9;
	}
	.theme-icon {
		position: absolute;
		top: 50%;
		width: 14px;
		height: 14px;
		transform: translateY(-50%);
		z-index: 1;
		transition: color 0.2s ease;
		pointer-events: none;
	}
	.sun-icon {
		left: 6px;
		color: rgb(var(--gray-dark));
	}
	.moon-icon {
		right: 6px;
		color: rgb(var(--gray));
	}
	:global(html[data-theme="dark"]) .sun-icon {
		color: rgb(var(--gray));
	}
	:global(html[data-theme="dark"]) .moon-icon {
		color: rgb(var(--gray-dark));
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links {
		display: flex;
		align-items: center;
	}
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links a {
			display: none;
		}
	}
</style>

<script is:inline>
	(function () {
		var btn = document.querySelector('.theme-toggle');
		if (!btn) return;
		btn.addEventListener('click', function () {
			var root = document.documentElement;
			var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
			root.setAttribute('data-theme', next);
			try { localStorage.setItem('theme', next); } catch (e) {}
		});
	})();
</script>
